require 'json'

source 'https://cdn.cocoapods.org/'
source 'https://github.com/ihreapotheken/IA-SDK-iOS/'

ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Every build configuration of the project, the flavors' Debug- and Release-<flavor> ones included (see
# scripts/add-example-ios-flavor.rb), so the pods build the flavors' Debug configurations as debug builds.
project 'IaSdkReactNativeExample', Xcodeproj::Project.open(File.join(__dir__, 'IaSdkReactNativeExample.xcodeproj')).build_configurations
  .to_h { |configuration| [configuration.name, configuration.name.start_with?('Debug') ? :debug : :release] }

# The ia.de SDK pods each module's React Native pod brings.
SDK_PODS = {
  'cardlink' => %w[IACardLink GematikOpenSSL],
  'ordering' => %w[IAOrdering],
  'over-the-counter' => %w[IAOverTheCounter],
  'pharmacy' => %w[IAPharmacy],
  'prescription' => %w[IAPrescription],
}.freeze

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'IaSdkReactNativeExample' do
  config = use_native_modules!

  # A module that only some flavors include (../flavors.json) links only into their configurations: react-native.config.js
  # restricts its React Native pod. CocoaPods doesn't apply that to a pod's dependencies, so the SDK pods it brings are
  # restricted here too.
  flavor_modules = JSON.parse(File.read(File.join(__dir__, '..', 'flavors.json'))).transform_values { |flavor| flavor['modules'] }
  flavor_modules.values.flatten.uniq.each do |sdk_module|
    flavors = flavor_modules.keys.select { |flavor| flavor_modules[flavor].include?(sdk_module) }
    next if flavors.length == flavor_modules.length

    configurations = flavors.flat_map { |flavor| flavor == 'demo' ? %w[Debug Release] : ["Debug-#{flavor}", "Release-#{flavor}"] }
    SDK_PODS.fetch(sdk_module).each { |sdk_pod| pod sdk_pod, :configurations => configurations }
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Workaround for `fmt` consteval compile errors under Xcode's newer clang
    # (e.g. iOS 26 SDK). The header `fmt/base.h` unconditionally re-defines
    # `FMT_USE_CONSTEVAL` based on compiler detection, so a `-D` preprocessor
    # flag is overwritten. Patch the header in-place to force the safe fallback.
    fmt_base_h = File.join(installer.sandbox.root, 'fmt/include/fmt/base.h')
    if File.exist?(fmt_base_h)
      original = File.read(fmt_base_h)
      patched = original.gsub('#  define FMT_USE_CONSTEVAL 1', '#  define FMT_USE_CONSTEVAL 0')
      if patched != original
        File.chmod(0644, fmt_base_h)
        File.write(fmt_base_h, patched)
        Pod::UI.puts "Patched fmt/base.h to force FMT_USE_CONSTEVAL=0".yellow
      end
    end
  end
end
