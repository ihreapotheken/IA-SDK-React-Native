{
  "name": "ia-sdk-react-native-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode demoDebug",
    "android:showcase": "react-native run-android --mode showcaseDebug",
    "ios": "react-native run-ios",
    "ios:showcase": "react-native run-ios --scheme showcase --mode Debug-showcase",
    "start": "react-native start",
    "build:android": "react-native build-android --mode demoDebug --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug"
  },
  "flavors": {
    "demo": "@ia-example/demo",
    "showcase": "@ia-example/prescription-upload-showcase"
  },
  "dependencies": {
    "@ia-example/demo": "workspace:*",
    "@ia-example/prescription-upload-showcase": "workspace:*",
    "react": "19.1.0",
    "react-native": "0.81.1",
    "react-native-safe-area-context": "^5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/metro-config": "0.81.1",
    "@react-native/typescript-config": "0.81.1",
    "@types/react": "^19.1.0",
    "react-native-builder-bob": "^0.40.16",
    "react-native-dotenv": "^3.4.11",
    "react-native-monorepo-config": "^0.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
