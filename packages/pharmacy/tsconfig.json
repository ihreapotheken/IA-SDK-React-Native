{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@ihreapotheken/ia-sdk-interface": ["../interface/src"],
      "@ihreapotheken/ia-sdk-core": ["../core/src"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  "exclude": ["example", "lib"]
}
