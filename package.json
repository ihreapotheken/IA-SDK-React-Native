{
  "name": "ia-sdk-react-native-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ihre Apotheken React Native SDK - Modular Monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihreapotheken/IA-SDK-React-Native.git"
  },
  "author": "ihreapotheken <info@ihreapotheken.de> (https://ihreapotheken.de)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ihreapotheken/IA-SDK-React-Native/issues"
  },
  "homepage": "https://github.com/ihreapotheken/IA-SDK-React-Native#readme",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A --topological run build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "clean": "yarn workspaces foreach -A run clean",
    "lint": "eslint \"packages/**/*.{js,ts,tsx}\"",
    "example": "yarn workspace ia-sdk-react-native-example",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.0.0",
    "turbo": "^2.5.6",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.2"
  },
  "packageManager": "yarn@4.11.0",
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
