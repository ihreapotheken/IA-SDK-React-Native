{
  "entryPoints": [
    "./packages/core/src/index.tsx",
    "./packages/interface/src/index.ts",
    "./packages/cardlink/src/index.tsx",
    "./packages/ordering/src/index.tsx",
    "./packages/over-the-counter/src/index.tsx",
    "./packages/pharmacy/src/index.tsx",
    "./packages/prescription/src/index.tsx"
  ],
  "exclude": [
    "node_modules/@nativescript/core",
    "**/*.android.ts",
    "**/*.ios.ts"
  ],
  "out": "docs",
  "excludePrivate": true,
  "excludeExternals": true,
  "includeVersion": true,
  "hideGenerator": true,
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true
  },
  "skipErrorChecking": true
}
