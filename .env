# Native library identifier for the Android AppSDK platform.
ANDROID_APPSDK_VERSION="2.7.0"

# Native library identifier for the iOS AppSDK platform.
IOS_APPSDK_VERSION="2.7.0"

# Server environment the demo app initializes the SDK with. One of
# "development" (DEV), "staging" (QA) or "production" (PROD). The matching
# short label is appended to the app name on the home screen so testers can
# tell which backend a build points at. Run `sh ./scripts/sync-app-label.sh`
# after changing this value to refresh the iOS display name.
SERVER_ENVIRONMENT="staging"
